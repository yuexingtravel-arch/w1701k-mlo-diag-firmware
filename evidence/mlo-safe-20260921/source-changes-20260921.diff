+function delay(ms) {
+    return new Promise(function(resolve) { setTimeout(resolve, ms); });
+}
+
+function withTimeout(promise, ms, stage) {
+    return new Promise(function(resolve, reject) {
+        var timer = setTimeout(function() {
+            reject(new Error(stage + ' timed out after ' + Math.ceil(ms / 1000) + ' s'));
+        }, ms);
+        Promise.resolve(promise).then(function(value) {
+            clearTimeout(timer);
+            resolve(value);
+        }, function(err) {
+            clearTimeout(timer);
+            reject(err);
+        });
+    });
+}
+
+function execChecked(command, params, stage, timeoutMs) {
+    return withTimeout(callExec(command, params || []), timeoutMs || 10000, stage).then(function(result) {
+        if (result && result.code != null && result.code !== 0)
+            throw new Error(stage + ' failed (exit ' + result.code + '): ' + (result.stderr || '').trim());
+        return result || {};
+    });
+}
+
+function wirelessStatus() {
+    return withTimeout(callWirelessStatus(), 6000, 'network.wireless status');

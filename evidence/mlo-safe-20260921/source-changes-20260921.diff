+}
+
+function pollMldReady(section, onProgress, maxWaitMs) {
+    var started = Date.now(), attempts = 0, lastReason = 'waiting for wireless status';
+    function check() {
+        attempts++;
+        if (onProgress) onProgress(attempts, lastReason);
+        return wirelessStatus().then(function(status) {
+            var runtime = findMldRuntime(status, section);
+            if (!runtime.radios.length) {
+                lastReason = 'MLO section ' + section + ' is not present in runtime status';
+                throw new Error(lastReason);
+            }
+            var bad = runtime.radios.filter(function(r) { return !r.up || r.pending || r.failed; });
+            if (bad.length) {
+                lastReason = bad.map(function(r) {
+                    return r.name + (r.failed ? ' setup failed' : r.pending ? ' pending' : ' down');
+                }).join(', ');
+                throw new Error(lastReason);
+            }
+            if (!runtime.ifname) {
+                lastReason = 'MLO interface name is not available yet';
+                throw new Error(lastReason);
+            }
+            return hostapdStatus(runtime.ifname).then(function(st) {
+                if (!st || st.status !== 'ENABLED') {
+                    lastReason = 'hostapd.' + runtime.ifname + ' is ' + ((st && st.status) || 'not ready');

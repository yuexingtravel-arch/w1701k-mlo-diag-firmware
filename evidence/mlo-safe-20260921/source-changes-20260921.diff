+
+function pollRadiosReady(names, onProgress, maxWaitMs) {
+    var started = Date.now(), attempts = 0, lastReason = 'waiting for radios';
+    function check() {
+        attempts++;
+        if (onProgress) onProgress(attempts, lastReason);
+        return wirelessStatus().then(function(status) {
+            var bad = names.filter(function(name) {
+                var radio = status[name] || {};
+                return radio.up !== true || radio.pending === true || radio.retry_setup_failed === true;
+            });
+            if (!bad.length) return status;
+            lastReason = bad.join(', ') + ' not ready';
+            throw new Error(lastReason);
+        }).catch(function(err) {
+            lastReason = (err && err.message) || String(err);
+            if (Date.now() - started >= maxWaitMs)
+                throw new Error('WiFi reload did not become ready: ' + lastReason);
+            return delay(2000).then(check);
+        });
+    }
+    return check();
+}

+
+function findMldRuntime(status, section) {
+    var radios = [], ifname = null;
+    Object.keys(status || {}).forEach(function(radioName) {
+        var radio = status[radioName] || {};
+        var matched = (radio.interfaces || []).filter(function(iface) {
+            return iface && iface.section === section;
+        });
+        if (!matched.length) return;
+        radios.push({
+            name: radioName,
+            up: radio.up === true,
+            pending: radio.pending === true,
+            failed: radio.retry_setup_failed === true
+        });
+        matched.some(function(iface) {
+            if (iface.ifname && /^[-_.a-zA-Z0-9]+$/.test(iface.ifname)) {
+                ifname = iface.ifname;
+                return true;
+            }
+            return false;
+        });
+    });
+    return { section: section, ifname: ifname, radios: radios };
+}
+
+function hostapdStatus(ifname) {
+    if (!ifname || !/^[-_.a-zA-Z0-9]+$/.test(ifname))
+        return Promise.reject(new Error('MLO runtime interface was not found'));
